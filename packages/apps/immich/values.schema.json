{
  "title": "Chart Values",
  "type": "object",
  "properties": {
    "database": {
      "description": "PostgreSQL configuration.",
      "type": "object",
      "default": {},
      "required": [
        "name",
        "replicas",
        "resourcesPreset",
        "size",
        "user"
      ],
      "properties": {
        "name": {
          "description": "Database name to create.",
          "type": "string",
          "default": "immich"
        },
        "password": {
          "description": "Optional password. When empty, the cozystack postgres chart generates and preserves one via lookup.",
          "type": "string",
          "default": ""
        },
        "replicas": {
          "description": "Number of database instances.",
          "type": "integer",
          "default": 2
        },
        "resourcesPreset": {
          "description": "Postgres sizing preset (`nano`..`2xlarge`).",
          "type": "string",
          "default": "medium"
        },
        "size": {
          "description": "Persistent Volume size for database storage.",
          "default": "10Gi",
          "pattern": "^(\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))))?$",
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "x-kubernetes-int-or-string": true
        },
        "user": {
          "description": "Database user to create.",
          "type": "string",
          "default": "immich"
        }
      }
    },
    "host": {
      "description": "Hostname for external access.",
      "type": "string",
      "default": ""
    },
    "ingressClass": {
      "description": "IngressClass name (defaults to tenant ingress class / namespace).",
      "type": "string",
      "default": ""
    },
    "ingressTls": {
      "description": "Enable TLS configuration for ingress.",
      "type": "boolean",
      "default": true
    },
    "redis": {
      "description": "Redis configuration.",
      "type": "object",
      "default": {},
      "required": [
        "replicas",
        "size"
      ],
      "properties": {
        "replicas": {
          "description": "Number of redis replicas.",
          "type": "integer",
          "default": 2
        },
        "size": {
          "description": "Persistent Volume size for redis storage.",
          "default": "1Gi",
          "pattern": "^(\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))))?$",
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "x-kubernetes-int-or-string": true
        }
      }
    },
    "size": {
      "description": "Persistent Volume Claim size for application data.",
      "default": "10Gi",
      "pattern": "^(\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))))?$",
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "x-kubernetes-int-or-string": true
    },
    "storageClass": {
      "description": "StorageClass used to store the data.",
      "type": "string",
      "default": ""
    }
  }
}